discovery.docker "project" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = sys.env("ALLOY_DISCOVERY_INTERVAL")

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }

}

discovery.relabel "application" {
  targets = discovery.docker.project.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "app|worker|batch-source"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "application" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.application.output
  labels     = { env = "development", level = "UNKNOWN" }
  forward_to = [loki.process.application.receiver]
}

loki.process "application" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      service   = "service",
      level     = "level",
      env       = "env",
      timestamp = "timestamp",
    }
  }

  stage.labels {
    values = {
      service = "service",
      level   = "level",
      env     = "env",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
    action_on_failure = "skip"
  }

  stage.label_keep {
    values = ["service", "level", "env"]
  }
}

loki.write "local" {
  endpoint {
    url                = "http://loki:3100/loki/api/v1/push"
    batch_size         = "256KiB"
    remote_timeout     = "5s"
    min_backoff_period = "1s"
    max_backoff_period = "5s"
    max_backoff_retries = 5
  }
}
