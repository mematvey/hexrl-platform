# Изолированный стенд защиты: docker compose -p hexrl-obs --env-file .env.obs ...
# Скопировать в .env.obs и заменить change-me. Порты не пересекаются с обычным
# стендом и с нагрузочным hexrl-hw4, поэтому оба могут работать одновременно.
# Для benchmark-override (ошибки inference) нужен ещё порт БД на хосте.
# app и worker читают env_file по этой переменной, иначе возьмут обычный .env
HEXRL_ENV_FILE=.env.obs
BENCHMARK_DB_PORT=28432
BOOTSTRAP_CONFIG=configs/navigation-dqn-smoke.toml
# Приложение и логирование
APP_HOST=0.0.0.0
APP_PORT=28000
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=change-me

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=28672
RABBITMQ_USER=hexrl
RABBITMQ_PASSWORD=change-me
RABBITMQ_MANAGEMENT_PORT=28673

# Очередь и обработка задач
QUEUE_PREFIX=hexrl.obs
QUEUE_MAX_LENGTH=20
WORKER_CONCURRENCY=2
PREFETCH_COUNT=2
INFERENCE_DELAY_S=0.5
MAX_DELIVERIES=3
RETRY_DELAY_MS=5000
RETRY_FORWARD_CONFIRM_TIMEOUT_MS=1000
PUBLISH_CONFIRM_TIMEOUT_S=0.5
BACKOFF_BASE_S=0.05
BACKOFF_CAP_S=1.0
BATCH_SOURCE_LOG_GRACE_S=3

# API: проверки и таймауты
HEALTH_TIMEOUT_SECONDS=2.0
TASK_SUBMISSION_TIMEOUT_S=0.75
TASK_CLEANUP_TIMEOUT_S=0.2
PENDING_TASK_TTL_S=60
PENDING_CLEANUP_INTERVAL_S=30
ESTIMATED_WORKER_COUNT=1

# Inference и модель
INFERENCE_PORT=8001
MLFLOW_TRACKING_URI=http://127.0.0.1:28500
MODEL_NAME=hex-navigation-smoke
MODEL_ALIAS=champion

# MLflow и хранилище артефактов
MLFLOW_PORT=28500
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=change-me
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_ARTIFACT_BUCKET=hexrl-obs
MLFLOW_ARTIFACT_PORT=28900
MLFLOW_ARTIFACT_ACCESS_KEY=change-me
MLFLOW_ARTIFACT_SECRET_KEY=change-me
MLFLOW_AWS_REGION=us-east-1

# OpenTelemetry: экспорт включается отдельно
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector-traces:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector-metrics:4318/v1/metrics
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_SERVICE_NAME задаётся отдельно каждому сервису
# service.instance.id по умолчанию - hostname контейнера
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
OTEL_EXPORTER_OTLP_TIMEOUT=0.5
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_METRIC_EXPORT_TIMEOUT=1000

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
GRAFANA_PORT=28300

# Наблюдаемость: хранение и сбор
LOKI_RETENTION=24h
TEMPO_RETENTION=24h
PROMETHEUS_RETENTION=24h
ALLOY_DISCOVERY_INTERVAL=2s
TEMPO_TRACE_IDLE_PERIOD=10s
TEMPO_GOMEMLIMIT=160MiB

# Tempo
TEMPO_CONFIG_FILE=config.yaml
